{
	"name": "lumemor-web",
	"version": "0.0.1",
	"private": true,
	"description": "SvelteKit single-page app for lumemor: adapter-static build output embedded into the Go server binary.",
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"tailwindcss": "^4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@fontsource/nunito": "^5.3.0",
		"@lucide/svelte": "^1.69.0",
		"blurhash": "^2.0.5",
		"maplibre-gl": "5.9.0",
		"svelte-i18n": "^4.0.1"
	}
}
