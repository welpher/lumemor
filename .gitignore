# Go
server/lumemor
server/lumemor-*
*.test
*.out
/vendor/

# Node / SvelteKit
node_modules/
.svelte-kit/
build/
dist/
.env
.env.*
!.env.example

# Web app build output and its staging tree for the Go embed: never
# committed. `make web-build` rebuilds web/build from source and stages
# the copy into server/internal/web/dist; CI and local Go builds run it
# first (a Go build without it fails at the embed directive).
web/build/
web/node_modules/
server/internal/web/dist/
# Playwright e2e artifacts: the story's saved session state and the
# failure outputs (traces, screenshots, videos).
web/e2e/.auth/
web/test-results/
# The writable source fixture's seeded photos (see that fixture's
# README): seeded per run, moved by the trash story, returned by the
# restore -- never committed; only the README is tracked.
web/e2e/fixtures/m3-source-rw/*
!web/e2e/fixtures/m3-source-rw/README.md

# Flutter / Dart
mobile/.dart_tool/
mobile/.flutter-plugins*
mobile/build/
mobile/coverage/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local data & tool output
data/
# Bind-mount target created by docker compose up (see docker-compose.yml).
/lumemor/
*.log
tools/models/cache/
